  "compilerOptions": {
    "noEmit": false,
    "outDir": "./build/server",
    "rootDir": "./server",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ]
  },
  "include": [
    "server/**/*.ts"
  ],
  "exclude": [
    "tests",
    "src"
  ]
}