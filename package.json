{
  "name": "bd-reporting-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && tsx watch server/index.ts --static",
    "build": "tsc --noEmit && vite build --configLoader runner && tsc -p tsconfig.server.json && node scripts/copy-migrations.mjs",
    "start": "node build/server/index.js --static",
    "start:hosted": "node build/server/hosted-index.js",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "admin:create": "node scripts/create-admin.mjs",
    "db:migrate": "tsx server/migrate.ts",
    "jobs:run": "tsx server/jobs.ts",
    "test:e2e": "playwright test",
    "dev:live": "tsx watch server/index.ts",
    "admin:create:stdin": "node build/server/create-admin.js",
    "backup": "node scripts/backup.mjs",
    "firebase:status": "node scripts/firebase-status.mjs",
    "firebase:import": "node scripts/firebase-import.mjs",
    "deploy:firebase": "firebase deploy --only firestore --project cadence-53781"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "firebase-admin": "^14.5.0",
    "lucide-react": "0.462.0",
    "nodemailer": "10.1.1",
    "pdfkit": "0.13.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.4",
    "serverless-http": "^4.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "@types/nodemailer": "8.0.1",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.32.0",
    "firebase-tools": "^15.34.0",
    "tsx": "4.23.12",
    "typescript": "5.7.3",
    "typescript-eslint": "8.38.0",
    "vite": "6.4.3",
    "xlsx": "0.18.5"
  },
  "engines": {
    "node": ">=24.0.0 <27"
  }
}
