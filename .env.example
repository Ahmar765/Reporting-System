NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/reporting.sqlite
# Production requires HTTPS; optional SMTP enables actual email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Only set behind a trusted loopback reverse proxy.
TRUST_PROXY=0
# Optional fonts for non-Latin PDF output.
PDF_FONT_PATH=
PDF_BOLD_FONT_PATH=
